# Enforce the `engines` range in package.json (Node ^24.15.0 || >=26.0.0, the
# intersection jsdom 30 and vitest 5 require; Node 25 is unsupported): without
# this npm only warns on an incompatible runtime. CI and the Docker build use
# Node 26, so the guard exists to fail fast on stale local toolchains.
engine-strict=true
